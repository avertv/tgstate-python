cat .env.example
# API Token вашего Telegram-бота. Получите его у @BotFather.
BOT_TOKEN=your_telegram_bot_token

# Цель для хранения файлов: username публичного канала (@username) или ваш Telegram ID.
CHANNEL_NAME=@your_telegram_channel_or_your_id

# [Опционально] Пароль для доступа к веб-интерфейсу. Если оставить пустым, пароль не потребуется.
PASS_WORD=your_secret_password

# [Опционально] API-ключ для интерфейса загрузки PicGo. Если оставить пустым, ключ не потребуется.
PICGO_API_KEY=your_picgo_api_key

# [Опционально] Публичный URL вашего сервиса для формирования полных ссылок на скачивание файлов.
BASE_URL=http://127.0.0.1:8000

# [Опционально] Настройки Telegram MTProto. Включение позволяет синхронизировать ручное удаление файлов в группе с веб-интерфейсом.
TG_API_ID=123456
TG_API_HASH=your_telegram_api_hash

# [Опционально] Имя сессии MTProto, строка сессии и интервал сверки (в секундах).
TELEGRAM_SYNC_SESSION=tgstate-sync
TELEGRAM_SYNC_SESSION_STRING=
# [Опционально] Базовый интервал сверки MTProto (в секундах). При превышении 1 000 / 10 000 файлов автоматически увеличивается минимум до 300 / 900 секунд.
TELEGRAM_RECONCILE_INTERVAL=60
